# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.

# Apify (https://console.apify.com/account/integrations) — used for Stage 1 scraping
APIFY_TOKEN=

# OpenAI (https://platform.openai.com/api-keys) — used for Stage 4 flyer art + captions
OPENAI_API_KEY=

# Optional: how far back the known-account monitor scrape looks each run.
# Keep this short once you're running daily — it's what keeps runs cheap.
MONITOR_LOOKBACK=2 days
