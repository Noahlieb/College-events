# ─────────────────────────────────────────────────────────────
# College Events Media Network — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- Database ---------------------------------------------------
# Local dev: local Postgres. Production: Supabase connection string.
DATABASE_URL=postgres://app:app@localhost:5432/college_events

# --- Supabase (production storage + Postgres) --------------------
# Leave blank in local dev; the app falls back to local disk storage
# and the DATABASE_URL above when these are unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=college-events-media

# --- Render service --------------------------------------------------
# Rendering runs as a separate standalone Vercel Function (apps/render-
# service), not inside the Next.js dashboard app — sharp couldn't be
# reliably bundled in Next's serverless output. Leave RENDER_SERVICE_URL
# unset in local dev; renderPost() runs in-process via the worker CLI
# instead. Both values must match what's set on the render-service's own
# Vercel project.
RENDER_SERVICE_URL=
RENDER_SERVICE_SECRET=

# --- AI providers -------------------------------------------------
# Set AI_PROVIDER to "anthropic" | "openai" | "mock".
# "mock" (default when no keys present) returns deterministic fake
# structured output so the pipeline runs end-to-end with no credentials.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Instagram collection (PhantomBuster) --------------------------
# Optional. Without it, use the manual JSON importer
# (apps/worker: `pnpm start ingest:phantombuster --file path.json`).
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=

# --- Scheduler (Buffer) --------------------------------------------
# SCHEDULER_PROVIDER = "buffer" | "mock". Defaults to "mock" so posts
# can be approved and "sent" without a live Buffer account.
SCHEDULER_PROVIDER=mock
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID_FAU=

# --- Dashboard auth --------------------------------------------------
# Simple shared-password gate for the internal admin dashboard (MVP).
# Replace with real auth (Supabase Auth / SSO) before onboarding
# multiple non-founder operators.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Storage -----------------------------------------------------
# Local dev falls back to writing rendered/raw media under this path
# when SUPABASE_URL is unset.
LOCAL_STORAGE_DIR=./storage

# --- App -----------------------------------------------------------
NODE_ENV=development
DASHBOARD_PORT=3000
